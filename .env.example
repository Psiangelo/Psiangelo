# Supabase credentials for the blog system
# Create a project at https://supabase.com and run setup/blog-schema.sql

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Plausible Analytics (opcional — privacy-friendly, sem cookies/LGPD banner)
# Crie conta em plausible.io e adicione o site; o domain e o valor que voce colocou la.
# Deixe vazio ou nao defina pra desativar completamente (Analytics.jsx renderiza null).
# Em producao, defina como repo variable no GitHub: PLAUSIBLE_DOMAIN
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
